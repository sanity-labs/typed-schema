{
  "name": "@sanity-labs/typed-schema",
  "version": "0.6.2",
  "description": "Experimental TypeScript-first schemas for Sanity",
  "keywords": [
    "sanity",
    "schema",
    "type-inference",
    "types",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/sanity-io/sanitype#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/sanitype/issues"
  },
  "license": "MIT",
  "author": "Bjørge Næss <bjoerge@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/sanitype.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "run-s pkg:build pkg:check check:publint check:attw",
    "changeset": "changeset",
    "check": "npm-run-all --serial clean pkg:build --parallel typecheck lint format:check knip test pkg:check check:publint check:attw",
    "check:attw": "pnpm pack --out .tmp/package.tgz && attw .tmp/package.tgz --profile esm-only",
    "check:publint": "publint --strict --pack pnpm",
    "clean": "rimraf dist",
    "coverage": "vitest run --coverage",
    "dev": "run-p pkg:watch typecheck:watch test:watch",
    "example:compat-studio": "(cd examples/compat-studio && npm run dev)",
    "examples": "run-p example:*",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "pkg:build": "pkg build --strict",
    "pkg:check": "pkg check --strict",
    "pkg:watch": "pkg watch --strict",
    "prepublishOnly": "pnpm run build",
    "release": "changeset publish",
    "test": "vitest run --typecheck",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --typecheck",
    "typecheck": "tsc",
    "typecheck:examples": "tsc -p ./examples/tsconfig.json",
    "typecheck:examples:watch": "tsc -p ./examples/tsconfig.json --watch",
    "typecheck:watch": "tsc --watch"
  },
  "dependencies": {
    "@sanity/types": "^6.18.0",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@sanity/client": "^8.9.0",
    "@sanity/pkg-utils": "^13.0.8",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "std-env": "^4.3.0",
    "taze": "^21.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.11.2"
}
